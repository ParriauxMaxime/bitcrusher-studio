{
	"$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noArrayIndexKey": "off"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!**/.rsbuild",
			"!**/coverage",
			"!.superpowers",
			"!.claude",
			"!docs",
			"!_wayback",
			"!src/content/generated.ts",
			"!public/media/.peaks-cache.json",
			"!public/og/.cache.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	}
}
